{
  "manifest_version": 3,
  "name": "Windows Update Probe",
  "version": "1.0.1",
  "description": "Offline windows.update regression probe for Android Browser.",
  "permissions": ["alarms", "storage", "downloads"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Windows Update Probe",
    "default_popup": "popup.html"
  }
}
